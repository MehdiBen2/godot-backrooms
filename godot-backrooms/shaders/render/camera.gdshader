shader_type canvas_item;
// Clean vanilla camera pass: pass-through to render the actual 3D game visuals
uniform sampler2D screen_tex : hint_screen_texture, filter_linear;

// Standard uniforms maintained for engine compatibility
uniform float cam_mode = 0.0;
uniform vec2 cam_spin = vec2(0.0);
uniform float shutter = 0.0;
uniform float blur_max_px = 0.0;
uniform float tape = 0.0;
uniform float iso = 1.0;
uniform float sharpen = 0.0;
uniform float codec = 0.0;
uniform float noise_luma = 0.0;
uniform float noise_chroma = 0.0;
uniform vec3 grade_digital = vec3(1.0);
uniform float vignette_amt = 1.0;
uniform vec3 grade = vec3(1.0);
uniform float distortion = 0.0;
uniform float cctv = 0.0;
uniform float chroma_amt = 0.0;
uniform float grain = 0.0;
uniform float vhs = 0.0;
uniform float vhs_soft = 0.0;
uniform float vhs_color_offset_multiplier = 0.0;
uniform float vhs_color_offset = 0.0;
uniform float vhs_blur_amount = 0.0;
uniform float dirt_amt = 0.0;
uniform float dirt_base = 0.0;
uniform float smudge_amt = 0.0;
uniform float smudge_base = 0.0;
uniform float smudge_soft = 0.0;
uniform float halation_amt = 0.0;
uniform float glare_amt = 0.0;
uniform float glare = 0.0;
uniform float fear = 0.0;
uniform float threat = 0.0;
uniform float glitch = 0.0;
uniform float pulse = 0.0;
uniform float classic = 0.0;
uniform float corrupt = 0.0;
uniform float mood = 0.0;
uniform float banding = 0.0;
uniform vec3 wb = vec3(1.0);
uniform float black_lift = 0.0;
uniform float exhaust = 0.0;
uniform float adrenaline = 0.0;
uniform float fx_blink = 0.0;
uniform int post_quality = 0;
uniform float insanity = 0.0;
uniform float fx_blur = 0.0;
uniform float fx_contrast = 1.0;
uniform float fx_sat = 1.0;
uniform float fx_hue = 0.0;
uniform float fx_zoom = 1.0;
uniform float fx_skew = 0.0;
uniform float fx_fade = 0.0;
uniform float fx_flash = 0.0;
uniform float fx_shock = 0.0;
uniform float fx_blood = 0.0;
uniform float fx_static = 0.0;
uniform float fx_warp = 0.0;
uniform float fall_blur = 0.0;
uniform vec2 fall_foe = vec2(0.5);
uniform float fall_warp = 0.0;
uniform float fall_fade = 0.0;

void fragment() {
	COLOR = texture(screen_tex, SCREEN_UV);
}
