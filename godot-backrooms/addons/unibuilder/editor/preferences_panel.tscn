[node name="Box" type="VBoxContainer" parent="."]
custom_minimum_size = Vector2(260, 0)

[node name="VertexRow" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="Label" type="Label" parent="Box/VertexRow"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
text = "Vertex size (px)"

[node name="VertexSize" type="SpinBox" parent="Box/VertexRow"]
