max_value = 24.0
value = 4.0

[node name="GrowRow" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="Label" type="Label" parent="Box/GrowRow"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
text = "Grow angle limit (°)"

[node name="GrowAngle" type="SpinBox" parent="Box/GrowRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Face-mode Grow skips neighbors whose normal deviates more than this. 180 = unlimited."
min_value = 1.0
max_value = 180.0
value = 1.0

[node name="LightmapRow" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="Label" type="Label" parent="Box/LightmapRow"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
text = "Bake lightmap texel"

[node name="LightmapTexel" type="SpinBox" parent="Box/LightmapRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Lightmap UV2s are unwrapped at this texel size, on bake and on live meshes. Changing it unwraps live meshes again. 0 = skip."
max_value = 10.0
step = 0.01

[node name="LiveUV2Row" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="Label" type="Label" parent="Box/LiveUV2Row"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
