[node name="LiveUV2" type="CheckBox" parent="Box/LiveUV2Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Set a bake lightmap texel above 0 to enable live UV2. It unwraps at that size."
disabled = true

