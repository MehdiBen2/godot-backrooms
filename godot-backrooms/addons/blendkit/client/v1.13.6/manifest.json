  "tools": [
    {
      "id": "export_glb",
      "name": "Export glTF/GLB",
      "description": "Re-exports the active scene to a self-contained .glb file. Enables the bundled glTF add-on if needed.",
      "software": "blender",
      "params": [
        {
          "name": "output_path",
          "type": "string",
          "required": true,
          "description": "Destination .glb path."
        },
        {
          "name": "yup",
          "type": "boolean",
          "default": true,
          "description": "Export using +Y up (glTF convention)."
        },
        {
          "name": "draco",
          "type": "boolean",
          "default": false,
          "description": "Apply Draco mesh compression."
        },
        {
          "name": "export_apply",
          "type": "boolean",
          "default": true,
          "description": "Apply modifiers before exporting."
        }
      ]
    },
    {
      "id": "export_usd",
      "name": "Export USD",
      "description": "Opens a downloaded Blendkit .blend, unpacks its packed textures, flattens shader node groups and exports a self-contained UsdPreviewSurface .usd file. Optionally also emits standalone MaterialX (.mtlx) materials plus a name-keyed mapping JSON alongside the .usd.",
      "software": "blender",
      "params": [
        {
          "name": "blend_path",
          "type": "string",
          "required": true,
          "description": "Input .blend file to open."
        },
        {
          "name": "out_usd",
          "type": "string",
          "required": true,
          "description": "Destination .usd path."
        },
        {
          "name": "max_resolution",
          "type": "string",
          "default": "ORIGINAL",
          "description": "Texture resolution cap: 512/1024/2048/4096/8192/ORIGINAL. Picks the textures subfolder suffix."
        },
        {
          "name": "export_mtlx",
          "type": "bool",
          "default": true,
          "description": "Also export one standalone .mtlx per material into <stem>_mtlx/ and write <stem>.materials.json mapping material names to their .mtlx files (for high-fidelity material binding in Maya/USD). Requires the MaterialX Python module bundled with Blender 4.1+; skipped gracefully if unavailable."
        }
      ]
    }
  ]
}
