# Exported builds (too large for git; published via GitHub Releases)
build/

# Exported launcher binaries (too large for git; send the exe directly)
launcher/*.exe
launcher/*.pck
launcher/_dev_install/

# Raw source assets (sound packs, source .glb/.zip). Keep them on a drive or a
# Release attachment; only the processed files inside godot-backrooms/ belong in git.
assetsimported/

# Generated by `godot --dump-extension-api`; regenerate when needed
extension_api.json

# Godot caches (also listed in the project's own .gitignore)
.godot/
*.tmp

# MCP addon screenshot cache
godot-backrooms/addons/godot_mcp/cache/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
